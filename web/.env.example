# Public, browser-safe configuration only.
#
# Anything prefixed VITE_ is inlined into the JavaScript bundle that every
# visitor downloads. Only keys that are safe to publish belong here.
#
# The publishable (anon) key is safe precisely because Row Level Security is
# enforced in the database: an insert with it is rejected 401 unless the signed
# in user is a named admin.
#
# NEVER put the service-role key, the secret key, the database password or the
# connection string in this file or in any VITE_ variable. Those bypass Row
# Level Security entirely and belong only in the server-side .env, which is
# gitignored.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
